# syntax=docker/dockerfile:1.7

FROM node:20-alpine AS build

WORKDIR /app

COPY server/package*.json ./server/
RUN npm ci --prefix server

COPY prisma ./prisma
RUN printf '# Please do not edit this file manually\n# It should be added in your version-control system (e.g., Git)\nprovider = "postgresql"\n' > prisma/migrations/migration_lock.toml
RUN sed 's#output   = "../node_modules/.prisma/client"#output   = "../server/node_modules/.prisma/client"#' prisma/schema.prisma > prisma/schema.docker.prisma
RUN cd server && PRISMA_GENERATE_SKIP_AUTOINSTALL=1 npx prisma generate --schema ../prisma/schema.docker.prisma

COPY server ./server
RUN cat > server/tsconfig.json <<'EOF'
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": "./src",
    "paths": {
      "@config/*": ["config/*"],
      "@middlewares/*": ["middlewares/*"],
      "@modules/*": ["modules/*"],
      "@utils/*": ["utils/*"],
      "@types/*": ["types/*"]
    },
    "typeRoots": ["./node_modules/@types", "./src/types"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/__tests__"]
}
EOF
RUN cat > server/src/server.ts <<'EOF'
import http from 'http';
import app from './app';
import { env } from './config/env';
import { logger } from './utils/logger';
import { connectDatabase, disconnectDatabase } from './config/database';
import { connectRedis, disconnectRedis } from './config/redis';
import { connectMinio } from './config/minio';
import { startExamScheduleCron, stopExamScheduleCron } from './utils/cron';
import { initSocketServer } from './socket';

const PORT = env.port;

async function bootstrap() {
  await connectDatabase();

  try {
    await connectRedis();
  } catch (error) {
    logger.error('Redis initialization failed (non-fatal):', error);
    logger.warn('Server will start but caching/realtime may be degraded');
  }

  try {
    await connectMinio();
  } catch (error) {
    logger.error('MinIO initialization failed (non-fatal):', error);
    logger.warn('Server will start but file uploads may be unavailable');
  }

  startExamScheduleCron();

  const httpServer = http.createServer(app);
  const io = initSocketServer(httpServer);

  httpServer.listen(PORT, () => {
    logger.info(`WebQuiz API Server running in ${env.nodeEnv} on port ${PORT}`);
  });

  const shutdown = async (signal: string) => {
    logger.info(`${signal} received. Starting graceful shutdown...`);
    io.close();
    httpServer.close(async () => {
      stopExamScheduleCron();
      await disconnectDatabase();
      await disconnectRedis();
      logger.info('Server closed. Process exiting.');
      process.exit(0);
    });
    setTimeout(() => {
      logger.error('Forced shutdown after timeout');
      process.exit(1);
    }, 10000);
  };

  process.on('SIGTERM', () => shutdown('SIGTERM'));
  process.on('SIGINT', () => shutdown('SIGINT'));
  process.on('unhandledRejection', (reason) => {
    logger.error('Unhandled Rejection:', reason);
  });
  process.on('uncaughtException', (error) => {
    logger.error('Uncaught Exception:', error);
    process.exit(1);
  });
}

bootstrap();
EOF
RUN npm run build --prefix server
RUN npm prune --prefix server --omit=dev

FROM node:20-alpine AS runtime

ENV NODE_ENV=production
ENV PORT=3000

RUN addgroup -S webquiz && adduser -S webquiz -G webquiz

WORKDIR /app

COPY --from=build --chown=webquiz:webquiz /app/server/package.json ./server/package.json
COPY --from=build --chown=webquiz:webquiz /app/server/dist ./server/dist
COPY --from=build --chown=webquiz:webquiz /app/server/node_modules ./server/node_modules
COPY --from=build --chown=webquiz:webquiz /app/prisma ./prisma

USER webquiz

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "server/dist/server.js"]
