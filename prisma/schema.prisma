generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ENUM TYPES (7)

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum QuestionKind {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  MATCHING
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  CLOSED
}

enum ScheduleStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

// How the final grade is derived when an exam allows multiple attempts.
enum GradingMethod {
  HIGHEST
  AVERAGE
  FIRST
  LAST
}

// How a student may move between questions while taking an exam.
enum NavigationMode {
  FREE
  SEQUENTIAL
}

enum ExamAttemptEventType {
  STARTED
  RESUMED
  HEARTBEAT
  ANSWER_SAVED
  TAB_HIDDEN
  WINDOW_BLUR
  COPY
  PASTE
  CONTEXT_MENU
  SHORTCUT_BLOCKED
  OFFLINE
  ONLINE
  SUBMITTED
  AUTO_SUBMITTED
}

enum BackupStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum ClassMemberRole {
  STUDENT
  TA
  NON_EDITING_TEACHER
  TEACHER
}

enum ClassResourceType {
  FILE
  IMAGE
  VIDEO
  LINK
  LESSON
}

enum ClassActivityType {
  QUIZ
  ASSIGNMENT
  FORUM
  WORKSHOP
  ATTENDANCE
  SURVEY
}

enum ClassPublishStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ClassSubmissionStatus {
  DRAFT
  SUBMITTED
  GRADED
  RETURNED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum DiscussionScope {
  CLASS
  GLOBAL
}

enum DiscussionType {
  ANNOUNCEMENT
  DISCUSSION
}

enum DiscussionAttachmentType {
  LINK
  FILE
  IMAGE
  VIDEO
}

// Distinguishes timetable slots that map to a managed Subject (MATH/PHY/CHEM —
// used for exam-conflict checking) from display-only slots (every other subject,
// flag ceremony, class meeting, …) that exist purely for viewing.
enum TimetableSlotKind {
  MANAGED_SUBJECT
  DISPLAY_ONLY
}

enum TimetableSlotStatus {
  ACTIVE
  CANCELLED
}

// USER MANAGEMENT

model User {
  id           Int        @id @default(autoincrement())
  role         UserRole   @default(STUDENT)
  username     String     @unique @db.VarChar(191)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  fullName     String?    @map("full_name") @db.VarChar(100)
  phone        String?    @db.VarChar(20)
  avatar       String?    @db.VarChar(255)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz()
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz()

  teachingClasses        Class[]                     @relation("TeacherClasses")
  enrolledClasses        ClassStudent[]
  createdQuestions       Question[]
  createdExams           Exam[]
  examAssignments        ExamAssignment[]
  examAttempts           ExamAttempt[]
  aiPracticeSessions     AiPracticeSession[]
  notifications          Notification[]
  activityLogs           ActivityLog[]
  backups                Backup[]
  webPushSubscriptions   WebPushSubscription[]
  studentProfile         StudentProfile?
  parentProfile          ParentProfile?
  classMemberRoles       ClassMemberRoleAssignment[]
  createdClassSections   ClassSection[]              @relation("ClassSectionCreator")
  createdClassResources  ClassResource[]             @relation("ClassResourceCreator")
  createdClassActivities ClassActivity[]             @relation("ClassActivityCreator")
  classSubmissions       ClassSubmission[]           @relation("ClassSubmissionStudent")
  gradedClassSubmissions ClassSubmission[]           @relation("ClassSubmissionGrader")
  classForumPosts        ClassForumPost[]
  attendanceRecords      ClassAttendanceRecord[]
  recordedAttendance     ClassAttendanceRecord[]     @relation("AttendanceRecorder")
  classCompletions       ClassCompletion[]
  classActivityLogs      ClassActivityLog[]
  discussions            Discussion[]
  discussionReplies      DiscussionReply[]
  discussionAttachments  DiscussionAttachment[]
  createdTimetableSlots  ClassTimetableSlot[]
  proctoredSchedules     ExamSchedule[]              @relation("ExamProctor")

  @@index([username, role])
  @@map("users")
}

model StudentProfile {
  studentCode       String   @id @map("student_id") @db.VarChar(50)
  userId            Int      @unique @map("user_id")
  parentCode        String?  @map("parent_id") @db.VarChar(50)
  fullName          String   @map("full_name") @db.VarChar(100)
  classId           Int?     @map("class_id")
  homeroomClassName String?  @map("homeroom_class_name") @db.VarChar(20)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent ParentProfile? @relation(fields: [parentCode], references: [parentCode], onDelete: SetNull)
  class  Class?         @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@index([parentCode])
  @@index([classId])
  @@index([homeroomClassName])
  @@map("students")
}

model ParentProfile {
  parentCode  String   @id @map("parent_id") @db.VarChar(50)
  userId      Int      @unique @map("user_id")
  phoneNumber String?  @unique @map("phone_number") @db.VarChar(20)
  fullName    String   @map("full_name") @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  children StudentProfile[]

  @@map("parents")
}

// ACADEMIC STRUCTURE (4 models)

model AcademicYear {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(20)
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  isCurrent Boolean  @default(false) @map("is_current")

  semesters Semester[]

  @@map("academic_years")
}

model Semester {
  id             Int      @id @default(autoincrement())
  academicYearId Int      @map("academic_year_id")
  name           String   @db.VarChar(20)
  startDate      DateTime @map("start_date") @db.Date
  endDate        DateTime @map("end_date") @db.Date

  academicYear   AcademicYear         @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classes        Class[]
  timetableSlots ClassTimetableSlot[]

  @@map("semesters")
}

model Class {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(20)
  gradeLevel    Int      @map("grade_level") @db.SmallInt
  semesterId    Int      @map("semester_id")
  teacherId     Int      @map("teacher_id")
  subjectId     Int      @map("subject_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  semester        Semester                    @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  teacher         User                        @relation("TeacherClasses", fields: [teacherId], references: [id], onDelete: Restrict)
  subject         Subject                     @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  classStudents   ClassStudent[]
  studentProfiles StudentProfile[]
  examAssignments ExamAssignment[]
  memberRoles     ClassMemberRoleAssignment[]
  sections        ClassSection[]
  resources       ClassResource[]
  activities      ClassActivity[]
  completions     ClassCompletion[]
  courseLogs      ClassActivityLog[]
  discussions     Discussion[]
  timetableSlots  ClassTimetableSlot[]
  examSchedules   ExamSchedule[]

  @@map("classes")
}

model ClassStudent {
  classId    Int      @map("class_id")
  studentId  Int      @map("student_id")
  enrolledAt DateTime @default(now()) @map("enrolled_at") @db.Timestamptz()

  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([classId, studentId])
  @@map("class_students")
}

model ClassMemberRoleAssignment {
  classId   Int             @map("class_id")
  userId    Int             @map("user_id")
  role      ClassMemberRole
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz()

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([classId, userId])
  @@index([userId, role])
  @@map("class_member_roles")
}

model ClassSection {
  id          Int      @id @default(autoincrement())
  classId     Int      @map("class_id")
  title       String   @db.VarChar(120)
  description String?  @db.Text
  orderIndex  Int      @default(0) @map("order_index")
  isPublished Boolean  @default(true) @map("is_published")
  createdBy   Int      @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  class      Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  creator    User            @relation("ClassSectionCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  resources  ClassResource[]
  activities ClassActivity[]

  @@index([classId, orderIndex])
  @@map("class_sections")
}

model ClassResource {
  id            Int               @id @default(autoincrement())
  classId       Int               @map("class_id")
  sectionId     Int?              @map("section_id")
  type          ClassResourceType
  title         String            @db.VarChar(200)
  description   String?           @db.Text
  content       String?           @db.Text
  url           String?           @db.Text
  fileName      String?           @map("file_name") @db.VarChar(255)
  mimeType      String?           @map("mime_type") @db.VarChar(120)
  fileSizeBytes Int?              @map("file_size_bytes")
  isPublished   Boolean           @default(true) @map("is_published")
  orderIndex    Int               @default(0) @map("order_index")
  createdBy     Int               @map("created_by")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  class       Class             @relation(fields: [classId], references: [id], onDelete: Cascade)
  section     ClassSection?     @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  creator     User              @relation("ClassResourceCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  completions ClassCompletion[]

  @@index([classId, sectionId, orderIndex])
  @@index([type])
  @@map("class_resources")
}

model ClassActivity {
  id                 Int                 @id @default(autoincrement())
  classId            Int                 @map("class_id")
  sectionId          Int?                @map("section_id")
  type               ClassActivityType
  title              String              @db.VarChar(200)
  instructions       String?             @db.Text
  content            String?             @db.Text
  status             ClassPublishStatus  @default(DRAFT)
  dueAt              DateTime?           @map("due_at") @db.Timestamptz()
  maxScore           Float?              @map("max_score") @db.DoublePrecision
  allowLate          Boolean             @default(false) @map("allow_late")
  showGrades         Boolean             @default(true) @map("show_grades")
  allowStudentPosts  Boolean             @default(true) @map("allow_student_posts")
  createdBy          Int                 @map("created_by")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  class             Class                   @relation(fields: [classId], references: [id], onDelete: Cascade)
  section           ClassSection?           @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  creator           User                    @relation("ClassActivityCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  submissions       ClassSubmission[]
  forumPosts        ClassForumPost[]
  attendanceRecords ClassAttendanceRecord[]
  completions       ClassCompletion[]

  @@index([classId, sectionId, status])
  @@index([type])
  @@map("class_activities")
}

model ClassSubmission {
  id          Int                   @id @default(autoincrement())
  activityId  Int                   @map("activity_id")
  studentId   Int                   @map("student_id")
  content     String?               @db.Text
  fileUrl     String?               @map("file_url") @db.Text
  fileName    String?               @map("file_name") @db.VarChar(255)
  status      ClassSubmissionStatus @default(SUBMITTED)
  score       Float?                @db.DoublePrecision
  feedback    String?               @db.Text
  submittedAt DateTime              @default(now()) @map("submitted_at") @db.Timestamptz()
  updatedAt   DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  gradedAt    DateTime?             @map("graded_at") @db.Timestamptz()
  gradedBy    Int?                  @map("graded_by")

  activity ClassActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  student  User          @relation("ClassSubmissionStudent", fields: [studentId], references: [id], onDelete: Cascade)
  grader   User?         @relation("ClassSubmissionGrader", fields: [gradedBy], references: [id], onDelete: SetNull)

  @@unique([activityId, studentId])
  @@index([studentId, status])
  @@map("class_submissions")
}

model ClassForumPost {
  id         Int      @id @default(autoincrement())
  activityId Int      @map("activity_id")
  authorId   Int      @map("author_id")
  parentId   Int?     @map("parent_id")
  content    String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  activity ClassActivity    @relation(fields: [activityId], references: [id], onDelete: Cascade)
  author   User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent   ClassForumPost?  @relation("ForumPostReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  ClassForumPost[] @relation("ForumPostReplies")

  @@index([activityId, createdAt])
  @@index([authorId])
  @@map("class_forum_posts")
}

model ClassAttendanceRecord {
  activityId Int              @map("activity_id")
  studentId  Int              @map("student_id")
  status     AttendanceStatus
  note       String?          @db.VarChar(255)
  recordedBy Int              @map("recorded_by")
  recordedAt DateTime         @default(now()) @map("recorded_at") @db.Timestamptz()

  activity ClassActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  student  User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recorder User          @relation("AttendanceRecorder", fields: [recordedBy], references: [id], onDelete: Restrict)

  @@id([activityId, studentId])
  @@index([studentId, status])
  @@map("class_attendance_records")
}

model ClassCompletion {
  id          Int      @id @default(autoincrement())
  classId     Int      @map("class_id")
  studentId   Int      @map("student_id")
  resourceId  Int?     @map("resource_id")
  activityId  Int?     @map("activity_id")
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamptz()

  class    Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  student  User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  resource ClassResource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  activity ClassActivity? @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([studentId, resourceId])
  @@unique([studentId, activityId])
  @@index([classId, studentId])
  @@map("class_completions")
}

model ClassActivityLog {
  id         Int      @id @default(autoincrement())
  classId    Int      @map("class_id")
  actorId    Int?     @map("actor_id")
  action     String   @db.VarChar(80)
  targetType String?  @map("target_type") @db.VarChar(50)
  targetId   Int?     @map("target_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([classId, createdAt])
  @@index([actorId])
  @@map("class_activity_logs")
}

// CURRICULUM (4 models)

model Subject {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(50)
  code        String  @unique @db.VarChar(10)
  description String? @db.Text
  status      Int     @default(1) @db.SmallInt

  chapters       Chapter[]
  questions      Question[]
  exams          Exam[]
  classes        Class[]
  timetableSlots ClassTimetableSlot[]

  @@map("subjects")
}

model Chapter {
  id         Int    @id @default(autoincrement())
  subjectId  Int    @map("subject_id")
  name       String @db.VarChar(100)
  gradeLevel Int    @map("grade_level") @db.SmallInt
  orderIndex Int    @map("order_index")

  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics    Topic[]
  questions Question[]

  @@index([subjectId, gradeLevel, orderIndex])
  @@map("chapters")
}

model Topic {
  id          Int     @id @default(autoincrement())
  chapterId   Int     @map("chapter_id")
  name        String  @db.VarChar(100)
  description String? @db.Text

  chapter            Chapter             @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  questions          Question[]
  fromRelations      TopicRelation[]     @relation("FromTopic")
  toRelations        TopicRelation[]     @relation("ToTopic")
  aiPracticeSessions AiPracticeSession[]

  @@map("topics")
}

model TopicRelation {
  id           Int    @id @default(autoincrement())
  fromTopicId  Int    @map("from_topic_id")
  toTopicId    Int    @map("to_topic_id")
  relationType String @map("relation_type") @db.VarChar(30)

  fromTopic Topic @relation("FromTopic", fields: [fromTopicId], references: [id], onDelete: Cascade)
  toTopic   Topic @relation("ToTopic", fields: [toTopicId], references: [id], onDelete: Cascade)

  @@map("topic_relations")
}

// QUESTION BANK (3 models)

model Question {
  id           Int          @id @default(autoincrement())
  subjectId    Int          @map("subject_id")
  chapterId    Int          @map("chapter_id")
  topicId      Int          @map("topic_id")
  content      String       @db.Text
  questionType QuestionKind @map("question_type")
  difficulty   Int          @db.SmallInt
  explanation  String?      @db.Text
  createdBy    Int          @map("created_by")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz()

  subject        Subject          @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  chapter        Chapter          @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  topic          Topic            @relation(fields: [topicId], references: [id], onDelete: Restrict)
  creator        User             @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  options        QuestionOption[]
  tags           QuestionTag[]
  examQuestions  ExamQuestion[]
  attemptAnswers AttemptAnswer[]

  @@map("questions")
}

model QuestionOption {
  id         Int     @id @default(autoincrement())
  questionId Int     @map("question_id")
  label      String  @db.Char(1)
  content    String  @db.Text
  isCorrect  Boolean @default(false) @map("is_correct")

  question       Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attemptAnswers AttemptAnswer[]

  @@map("question_options")
}

model QuestionTag {
  id         Int    @id @default(autoincrement())
  questionId Int    @map("question_id")
  tagName    String @map("tag_name") @db.VarChar(50)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_tags")
}

// EXAM & TESTING (4 models)

model Exam {
  id             Int        @id @default(autoincrement())
  title          String     @db.VarChar(200)
  subjectId      Int        @map("subject_id")
  createdBy      Int        @map("created_by")
  durationMin    Int        @map("duration_min")
  totalQuestions Int        @map("total_questions")
  passingScore   Decimal?   @map("passing_score") @db.Decimal
  shuffle        Boolean    @default(false)
  showResult     Boolean    @default(true) @map("show_result")
  maxAttempts    Int        @default(1) @map("max_attempts") @db.SmallInt
  gradingMethod  GradingMethod @default(HIGHEST) @map("grading_method")
  shuffleAnswers   Boolean        @default(false) @map("shuffle_answers")
  navigationMode   NavigationMode @default(FREE) @map("navigation_mode")
  questionsPerPage Int?           @map("questions_per_page")
  accessPassword   String?        @map("access_password") @db.VarChar(100)
  reviewOptions    Json?          @map("review_options")
  status         ExamStatus @default(DRAFT)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz()

  subject         Subject          @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  creator         User             @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  examQuestions   ExamQuestion[]
  examSchedules   ExamSchedule[]
  examAssignments ExamAssignment[]
  examAttempts    ExamAttempt[]

  @@map("exams")
}

model ExamQuestion {
  examId     Int     @map("exam_id")
  questionId Int     @map("question_id")
  orderIndex Int     @map("order_index")
  points     Decimal @db.Decimal

  exam     Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([examId, questionId])
  @@map("exam_questions")
}

model ExamSchedule {
  id        Int            @id @default(autoincrement())
  examId    Int            @map("exam_id")
  // Per-class schedule (Phase 5): when set, this window applies ONLY to this class.
  // null = applies to every class the exam is assigned to (legacy/global behaviour).
  classId   Int?           @map("class_id")
  startTime DateTime       @map("start_time") @db.Timestamptz()
  endTime   DateTime       @map("end_time") @db.Timestamptz()
  // Phase 6: where the exam is sat and who supervises it (informational + conflict hints).
  room      String?        @db.VarChar(50)
  proctorId Int?           @map("proctor_id")
  status    ScheduleStatus @default(PENDING)

  exam    Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)
  class   Class? @relation(fields: [classId], references: [id], onDelete: Cascade)
  proctor User?  @relation("ExamProctor", fields: [proctorId], references: [id], onDelete: SetNull)

  @@index([classId])
  @@index([proctorId])
  @@map("exam_schedules")
}

model ExamAssignment {
  id                 Int                 @id @default(autoincrement())
  examId             Int                 @map("exam_id")
  classId            Int                 @map("class_id")
  assignedBy         Int                 @map("assigned_by")
  assignedAt         DateTime            @default(now()) @map("assigned_at") @db.Timestamptz()

  exam          Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  class         Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  assignedTo    User           @relation(fields: [assignedBy], references: [id], onDelete: Restrict)

  @@map("exam_assignments")
}

// CLASS TIMETABLE (1 model)

// One cell of a class's weekly timetable. Managed subjects (Mathematics/Physics/
// Chemistry) point at a Subject row and are used to block conflicting exam schedules;
// every other subject is stored as a display-only label (subjectId = null).
model ClassTimetableSlot {
  id            Int                 @id @default(autoincrement())
  classId       Int                 @map("class_id")
  semesterId    Int?                @map("semester_id")
  subjectId     Int?                @map("subject_id")
  displayName   String              @map("display_name") @db.VarChar(100)
  kind          TimetableSlotKind   @default(DISPLAY_ONLY)
  status        TimetableSlotStatus @default(ACTIVE)
  dayOfWeek     Int                 @map("day_of_week") @db.SmallInt
  periodIndex   Int                 @map("period_index") @db.SmallInt
  startMinute   Int                 @map("start_minute")
  endMinute     Int                 @map("end_minute")
  room          String?             @db.VarChar(50)
  note          String?             @db.VarChar(255)
  effectiveFrom DateTime?           @map("effective_from") @db.Date
  effectiveTo   DateTime?           @map("effective_to") @db.Date
  createdBy     Int                 @map("created_by")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  class    Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  semester Semester? @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  subject  Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  creator  User      @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([classId, dayOfWeek, periodIndex])
  @@index([classId, dayOfWeek, startMinute, endMinute])
  @@index([subjectId])
  @@map("class_timetable_slots")
}

// RESULTS & ANALYTICS (2 models)

model ExamAttempt {
  id              Int           @id @default(autoincrement())
  examId          Int           @map("exam_id")
  studentId       Int           @map("student_id")
  startedAt       DateTime      @default(now()) @map("started_at") @db.Timestamptz()
  submittedAt     DateTime?     @map("submitted_at") @db.Timestamptz()
  isAutoSubmitted Boolean       @default(false) @map("is_auto_submitted")
  totalScore      Decimal?      @map("total_score") @db.Decimal
  timeSpentSec    Int?          @map("time_spent_sec")
  status          AttemptStatus @default(IN_PROGRESS)

  exam               Exam                @relation(fields: [examId], references: [id], onDelete: Cascade)
  student            User                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attemptAnswers     AttemptAnswer[]
  attemptEvents      ExamAttemptEvent[]
  aiPracticeSessions AiPracticeSession[]

  @@index([studentId, examId])
  @@map("exam_attempts")
}

model ExamAttemptEvent {
  id               Int                  @id @default(autoincrement())
  attemptId        Int                  @map("attempt_id")
  type             ExamAttemptEventType
  occurredAt       DateTime             @default(now()) @map("occurred_at") @db.Timestamptz()
  clientElapsedSec Int?                 @map("client_elapsed_sec")
  questionId       Int?                 @map("question_id")
  metadata         Json?

  attempt ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId, occurredAt])
  @@index([attemptId, type])
  @@index([type, occurredAt])
  @@map("exam_attempt_events")
}

model AttemptAnswer {
  id                Int     @id @default(autoincrement())
  attemptId         Int     @map("attempt_id")
  questionId        Int     @map("question_id")
  selectedOptionId  Int?    @map("selected_option_id")
  selectedOptionIds Json?   @map("selected_option_ids")
  answerText        String? @map("answer_text") @db.Text
  isCorrect         Boolean @default(false) @map("is_correct")
  timeSpentSec      Int?    @map("time_spent_sec")
  answerChanges     Int     @default(0) @map("answer_changes")
  manualScore       Decimal?  @map("manual_score") @db.Decimal
  manualFeedback    String?   @map("manual_feedback") @db.Text
  gradedBy          Int?      @map("graded_by")
  gradedAt          DateTime? @map("graded_at") @db.Timestamptz()

  attempt        ExamAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption QuestionOption? @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@map("attempt_answers")
}

// AI ADAPTIVE (2 models)

model AiPracticeSession {
  id              Int      @id @default(autoincrement())
  studentId       Int      @map("student_id")
  topicId         Int      @map("topic_id")
  sourceAttemptId Int      @map("source_attempt_id")
  totalQuestions  Int      @map("total_questions")
  correctAnswers  Int      @default(0) @map("correct_answers")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()

  student       User                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topic         Topic                 @relation(fields: [topicId], references: [id], onDelete: Cascade)
  sourceAttempt ExamAttempt           @relation(fields: [sourceAttemptId], references: [id], onDelete: Cascade)
  questions     AiGeneratedQuestion[]

  @@map("ai_practice_sessions")
}

model AiGeneratedQuestion {
  id            Int      @id @default(autoincrement())
  sessionId     Int      @map("session_id")
  content       String   @db.Text
  optionsJson   Json     @map("options_json")
  correctOption String   @map("correct_option") @db.Char(1)
  explanation   String?  @db.Text
  studentAnswer String?  @map("student_answer") @db.Char(1)
  isCorrect     Boolean? @map("is_correct")

  session AiPracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("ai_generated_questions")
}

// SYSTEM ADMIN (5 models)

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  title     String   @db.VarChar(200)
  message   String   @db.Text
  type      String   @db.VarChar(30)
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model ActivityLog {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")
  action     String   @db.VarChar(50)
  entityType String?  @map("entity_type") @db.VarChar(50)
  entityId   Int?     @map("entity_id")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("activity_logs")
}

model SystemConfig {
  id          Int      @id @default(autoincrement())
  configKey   String   @unique @map("config_key") @db.VarChar(50)
  configValue String   @map("config_value") @db.Text
  description String?  @db.VarChar(255)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("system_configs")
}

model Backup {
  id         Int          @id @default(autoincrement())
  filename   String       @db.VarChar(255)
  fileSizeMb Decimal?     @map("file_size_mb") @db.Decimal
  createdBy  Int          @map("created_by")
  status     BackupStatus @default(IN_PROGRESS)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz()

  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@map("backups")
}

model WebPushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  endpoint  String   @db.Text
  p256dhKey String   @map("p256dh_key") @db.VarChar(255)
  authKey   String   @map("auth_key") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("web_push_subscriptions")
}

// DISCUSSIONS & ANNOUNCEMENTS (2 models)

model Discussion {
  id        Int             @id @default(autoincrement())
  scope     DiscussionScope @default(CLASS)
  type      DiscussionType  @default(DISCUSSION)
  classId   Int?            @map("class_id")
  authorId  Int             @map("author_id")
  title     String          @db.VarChar(200)
  content   String          @db.Text
  isPinned  Boolean         @default(false) @map("is_pinned")
  isLocked  Boolean         @default(false) @map("is_locked")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  class   Class?            @relation(fields: [classId], references: [id], onDelete: Cascade)
  author  User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies DiscussionReply[]
  attachments DiscussionAttachment[]

  @@index([scope, classId, createdAt])
  @@index([type, createdAt])
  @@index([authorId])
  @@map("discussions")
}

model DiscussionReply {
  id           Int      @id @default(autoincrement())
  discussionId Int      @map("discussion_id")
  authorId     Int      @map("author_id")
  content      String   @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  author     User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  attachments DiscussionAttachment[]

  @@index([discussionId, createdAt])
  @@index([authorId])
  @@map("discussion_replies")
}

model DiscussionAttachment {
  id           Int                      @id @default(autoincrement())
  discussionId Int                      @map("discussion_id")
  replyId      Int?                     @map("reply_id")
  uploaderId   Int                      @map("uploader_id")
  type         DiscussionAttachmentType
  url          String                   @db.Text
  title        String?                  @db.VarChar(255)
  fileName     String?                  @map("file_name") @db.VarChar(255)
  mimeType     String?                  @map("mime_type") @db.VarChar(120)
  fileSizeBytes Int?                    @map("file_size_bytes")
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz()

  discussion Discussion       @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  reply      DiscussionReply? @relation(fields: [replyId], references: [id], onDelete: Cascade)
  uploader   User            @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([discussionId, createdAt])
  @@index([replyId])
  @@index([uploaderId])
  @@map("discussion_attachments")
}
