// IMPORT PIPELINE — guided multi-source question import (PDF §8 / §9)
// An ImportJob persists one upload attempt so parsing can run in the background,
// progress can be polled, the original file can be retried, and the teacher can
// leave and come back. ImportPreviewItem holds each extracted question (never
// saved to the bank until the teacher commits) with its validation result.

enum ImportJobStatus {
  PENDING     // created, original file stored, parse not started yet
  PARSING     // background parse/validation in progress
  READY       // parsed + validated, awaiting teacher review/commit
  COMMITTING  // selected items being written to the question bank
  COMPLETED   // committed (some/all items saved)
  FAILED      // parse failed; errorMessage explains why, retry allowed
}

enum ImportPreviewItemStatus {
  PENDING    // extracted, not yet reviewed
  VALID      // passes validation (no critical errors) — selectable for commit
  INVALID    // has critical errors — blocked from commit until fixed
  SKIPPED    // teacher chose to skip this item
  COMMITTED  // saved into the question bank (questionId set)
}

model ImportJob {
  id            Int             @id @default(autoincrement())
  fileName      String          @map("file_name") @db.VarChar(255)
  fileType      String          @map("file_type") @db.VarChar(100)
  // Detected logical source: excel | document | zip | gift (drives the parser).
  sourceFormat  String          @map("source_format") @db.VarChar(20)
  // MinIO object name of the stored original file (for retry / audit).
  sourceObject  String?         @map("source_object") @db.Text
  status        ImportJobStatus @default(PENDING)
  progress      Int             @default(0)
  totalItems    Int             @default(0) @map("total_items")
  validItems    Int             @default(0) @map("valid_items")
  invalidItems  Int             @default(0) @map("invalid_items")
  warningCount  Int             @default(0) @map("warning_count")
  importedCount Int             @default(0) @map("imported_count")
  // Target taxonomy chosen on the upload step (applied on commit).
  subjectId     Int?            @map("subject_id")
  chapterId     Int?            @map("chapter_id")
  // Which parser produced the result (regex | openai | excel | zip) — shown in UI.
  parserSource  String?         @map("parser_source") @db.VarChar(20)
  errorMessage  String?         @map("error_message") @db.Text
  createdBy     Int             @map("created_by")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  completedAt   DateTime?       @map("completed_at") @db.Timestamptz()

  creator User                @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  items   ImportPreviewItem[]

  @@index([createdBy, createdAt])
  @@index([status])
  @@map("import_jobs")
}

model ImportPreviewItem {
  id             Int                     @id @default(autoincrement())
  importJobId    Int                     @map("import_job_id")
  orderIndex     Int                     @map("order_index")
  rawText        String?                 @map("raw_text") @db.Text
  // The editable question payload: { content, questionType, difficulty,
  // explanation, options[], questionImageUrl, explanationImageUrl }.
  normalizedJson Json                    @map("normalized_json")
  // Validation result: { critical: string[], warnings: string[], confidence }.
  validationJson Json                    @map("validation_json")
  // Possible duplicates of this item already in the bank:
  // { matches: [{ questionId, similarity, method, contentPreview, questionType }] }.
  duplicateJson  Json?                   @map("duplicate_json")
  confidence     Float                   @default(1)
  sourcePage     Int?                    @map("source_page")
  sourceLine     Int?                    @map("source_line")
  status         ImportPreviewItemStatus @default(PENDING)
  // Set once committed so re-commits are idempotent.
  questionId     Int?                    @map("question_id")
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  job ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId, orderIndex])
  @@map("import_preview_items")
}

