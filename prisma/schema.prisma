// ADVANCED ANALYTICS — snapshot cache for the reporting upgrade (4 models)
// These tables cache heavy per-exam analytics so dashboards load fast. They are
// recomputed by the analytics engine and invalidated on submit / grade / delete,
// so they are treated as a derived cache (no FK to question/option needed —
// rows are scoped + cascade-deleted by exam, and overwritten on each recompute).
// classId = 0 is the sentinel for "all assigned classes" (keeps @@unique usable).

enum ReportSnapshotStatus {
  PENDING
  READY
  STALE
}

model ExamReportSnapshot {
  id                    Int                  @id @default(autoincrement())
  examId                Int                  @map("exam_id")
